{
    "name": "issuedesk",
    "private": true,
    "version": "1.4.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:qr": "node scripts/qr-studio-dev.mjs",
        "test:qr": "node --test scripts/qr-studio-checks.mjs",
        "build": "vite build",
        "lint": "eslint .",
        "preview": "pnpm run build && wrangler pages dev",
        "deploy": "pnpm run build && wrangler pages deploy",
        "cf-typegen": "wrangler types",
        "migrate": "pnpm exec wrangler d1 migrations list issuedesk-db --remote",
        "migrate-apply": "pnpm exec wrangler d1 migrations apply issuedesk-db --remote"
    },
    "dependencies": {
        "@ffmpeg/core": "^0.12.10",
        "@ffmpeg/ffmpeg": "^0.12.15",
        "lucide-react": "^1.66.0",
        "mermaid": "^12.3.0",
        "pdf-lib": "^1.17.1",
        "pdfjs-dist": "^6.5.438",
        "qr-code-styling": "^1.9.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "react-router": "^8.5.1",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@base-ui/react": "^1.9.0",
        "@eslint/js": "^10.0.1",
        "@fontsource-variable/inter": "^5.3.0",
        "@jsquash/avif": "^2.1.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.2",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.14.0",
        "gsap": "^3.15.0",
        "heic2any": "^0.0.4",
        "jszip": "^3.10.2",
        "shadcn": "^4.23.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "vite": "^8.3.5",
        "wrangler": "^4.156.2"
    }
}
