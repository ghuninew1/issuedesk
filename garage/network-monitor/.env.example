ROUTER_HOST=192.168.11.1
ROUTER_API_PORT=8886
ROUTER_TLS_SERVER_NAME=e3210e5c5b67.sn.mynetname.net
ROUTER_USERNAME=issuedesk-monitor
ROUTER_PASSWORD=

# HTTPS origin of the deployed IssueDesk site, without a trailing slash.
# The agent appends /api/network/agent/report.
ISSUEDESK_API_URL=
# Use the same random token as the Cloudflare Pages secret NETWORK_AGENT_TOKEN.
ISSUEDESK_AGENT_TOKEN=
# Cloudflare Zero Trust Service Token for the Access application covering /api.
# Set both values from the same Service Token; do not reuse either as the API bearer token.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

POLL_INTERVAL_SECONDS=30
ROUTER_TIMEOUT_SECONDS=10
ISSUEDESK_REQUEST_TIMEOUT_SECONDS=10
MAX_SEND_ATTEMPTS=5
LOG_LEVEL=INFO
TZ=Asia/Bangkok
