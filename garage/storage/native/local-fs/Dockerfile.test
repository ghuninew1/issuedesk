ARG NODE_IMAGE=node:22.23.4-alpine
FROM ${NODE_IMAGE} AS build
RUN apk add --no-cache build-base linux-headers
WORKDIR /prototype
COPY confined.c .
RUN cc -std=c11 -O2 -Wall -Wextra -Werror -DNAPI_VERSION=8 -I/usr/local/include/node -shared -fPIC confined.c -o confined.node

FROM ${NODE_IMAGE}
WORKDIR /prototype
COPY --from=build /prototype/confined.node .
COPY security.cjs .
USER 1000:1000
CMD ["node", "security.cjs"]
