# Use the test Ubuntu LAN IPv4 and the actual client subnet.
SPEED_TEST_BIND=192.168.50.20
SPEED_TEST_PORT=8443
SPEED_TEST_CLIENT_CIDR=192.168.50.0/24
SPEED_TEST_ISSUEDESK_ORIGIN=https://issuedesk-test.example
SPEED_TEST_AGENT_ORIGIN=https://speed-test.lan.example:8443
# Set the same independently generated 32-byte hex secret in the test Pages Function.
SPEED_TEST_GRANT_KEY=
SPEED_TEST_TLS_DIR=/path/to/test-agent-tls
